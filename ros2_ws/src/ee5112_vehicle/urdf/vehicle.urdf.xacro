<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="ee5112_ackermann_vehicle">

  <!-- ========================================================= -->
  <!-- EE5112 MiniLab 1.2 - Task 2                              -->
  <!-- Ackermann vehicle + RGB camera + 2D LiDAR                -->
  <!-- +x forward, +y left, +z upward                           -->
  <!-- Front-wheel steering / rear-wheel drive                  -->
  <!-- ========================================================= -->


  <!-- ========================================================= -->
  <!-- XACRO ARGUMENTS                                          -->
  <!-- ========================================================= -->

  <xacro:arg name="controllers_file" default=""/>


  <!-- ========================================================= -->
  <!-- VEHICLE PARAMETERS                                       -->
  <!-- ========================================================= -->

  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.20"/>
  <xacro:property name="chassis_height" value="0.12"/>

  <xacro:property name="wheelbase" value="0.20"/>
  <xacro:property name="track" value="0.16"/>

  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <xacro:property name="max_speed" value="0.50"/>

  <xacro:property
      name="steering_limit"
      value="${35.0 * pi / 180.0}"/>


  <!-- ========================================================= -->
  <!-- DERIVED GEOMETRY                                         -->
  <!-- ========================================================= -->

  <xacro:property
      name="base_height"
      value="${wheel_radius + chassis_height / 2.0}"/>

  <xacro:property
      name="front_x"
      value="${wheelbase / 2.0}"/>

  <xacro:property
      name="rear_x"
      value="${-wheelbase / 2.0}"/>

  <xacro:property
      name="left_y"
      value="${track / 2.0}"/>

  <xacro:property
      name="right_y"
      value="${-track / 2.0}"/>

  <xacro:property
      name="wheel_z"
      value="${-chassis_height / 2.0}"/>


  <!-- ========================================================= -->
  <!-- MASS PARAMETERS                                          -->
  <!-- ========================================================= -->

  <xacro:property name="chassis_mass" value="2.0"/>
  <xacro:property name="wheel_mass" value="0.10"/>
  <xacro:property name="knuckle_mass" value="0.05"/>


  <!-- ========================================================= -->
  <!-- MATERIALS                                                -->
  <!-- ========================================================= -->

  <material name="body_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>

  <material name="steering_grey">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>

  <material name="sensor_dark">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="camera_lens_colour">
    <color rgba="0.25 0.25 0.30 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT                                           -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
        xyz="0 0 ${base_height}"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- CHASSIS                                                  -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>

      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>

      <material name="body_blue"/>

    </visual>


    <collision>

      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="${chassis_mass}"/>

      <inertia
          ixx="${chassis_mass / 12.0 *
                 (chassis_width * chassis_width +
                  chassis_height * chassis_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${chassis_mass / 12.0 *
                 (chassis_length * chassis_length +
                  chassis_height * chassis_height)}"
          iyz="0.0"
          izz="${chassis_mass / 12.0 *
                 (chassis_length * chassis_length +
                  chassis_width * chassis_width)}"/>

    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- FRONT WHEEL MACRO                                        -->
  <!-- ========================================================= -->

  <xacro:macro name="front_wheel"
               params="side x y">

    <!-- Steering knuckle -->

    <link name="front_${side}_steering_link">

      <visual>

        <origin
            xyz="0 0 0.025"
            rpy="0 0 0"/>

        <geometry>
          <box size="0.025 0.025 0.070"/>
        </geometry>

        <material name="steering_grey"/>

      </visual>


      <collision>

        <origin
            xyz="0 0 0.025"
            rpy="0 0 0"/>

        <geometry>
          <box size="0.025 0.025 0.070"/>
        </geometry>

      </collision>


      <inertial>

        <origin
            xyz="0 0 0.025"
            rpy="0 0 0"/>

        <mass value="${knuckle_mass}"/>

        <inertia
            ixx="0.00003"
            ixy="0.0"
            ixz="0.0"
            iyy="0.00003"
            iyz="0.0"
            izz="0.00001"/>

      </inertial>

    </link>


    <!-- Steering joint -->

    <joint
        name="front_${side}_steering_joint"
        type="revolute">

      <parent link="base_link"/>
      <child link="front_${side}_steering_link"/>

      <origin
          xyz="${x} ${y} ${wheel_z}"
          rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
          lower="${-steering_limit}"
          upper="${steering_limit}"
          effort="20.0"
          velocity="2.0"/>

      <dynamics
          damping="0.20"
          friction="0.05"/>

    </joint>


    <!-- Front wheel -->

    <link name="front_${side}_wheel_link">

      <visual>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

        <material name="wheel_black"/>

      </visual>


      <collision>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

      </collision>


      <inertial>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <mass value="${wheel_mass}"/>

        <inertia
            ixx="${wheel_mass *
                   (3.0 * wheel_radius * wheel_radius +
                    wheel_width * wheel_width) / 12.0}"
            ixy="0.0"
            ixz="0.0"
            iyy="${0.5 *
                   wheel_mass *
                   wheel_radius *
                   wheel_radius}"
            iyz="0.0"
            izz="${wheel_mass *
                   (3.0 * wheel_radius * wheel_radius +
                    wheel_width * wheel_width) / 12.0}"/>

      </inertial>

    </link>


    <!-- Free-rolling front wheel -->

    <joint
        name="front_${side}_wheel_joint"
        type="continuous">

      <parent link="front_${side}_steering_link"/>
      <child link="front_${side}_wheel_link"/>

      <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <dynamics
          damping="0.02"
          friction="0.01"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- REAR WHEEL MACRO                                         -->
  <!-- ========================================================= -->

  <xacro:macro name="rear_wheel"
               params="side x y">

    <link name="rear_${side}_wheel_link">

      <visual>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

        <material name="wheel_black"/>

      </visual>


      <collision>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

      </collision>


      <inertial>

        <origin
            xyz="0 0 0"
            rpy="${pi / 2.0} 0 0"/>

        <mass value="${wheel_mass}"/>

        <inertia
            ixx="${wheel_mass *
                   (3.0 * wheel_radius * wheel_radius +
                    wheel_width * wheel_width) / 12.0}"
            ixy="0.0"
            ixz="0.0"
            iyy="${0.5 *
                   wheel_mass *
                   wheel_radius *
                   wheel_radius}"
            iyz="0.0"
            izz="${wheel_mass *
                   (3.0 * wheel_radius * wheel_radius +
                    wheel_width * wheel_width) / 12.0}"/>

      </inertial>

    </link>


    <!-- Rear driven wheel -->

    <joint
        name="rear_${side}_wheel_joint"
        type="continuous">

      <parent link="base_link"/>
      <child link="rear_${side}_wheel_link"/>

      <origin
          xyz="${x} ${y} ${wheel_z}"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <dynamics
          damping="0.02"
          friction="0.01"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- CREATE FOUR WHEELS                                       -->
  <!-- ========================================================= -->

  <xacro:front_wheel
      side="left"
      x="${front_x}"
      y="${left_y}"/>

  <xacro:front_wheel
      side="right"
      x="${front_x}"
      y="${right_y}"/>

  <xacro:rear_wheel
      side="left"
      x="${rear_x}"
      y="${left_y}"/>

  <xacro:rear_wheel
      side="right"
      x="${rear_x}"
      y="${right_y}"/>


  <!-- ========================================================= -->
  <!-- CAMERA LINK                                              -->
  <!-- ========================================================= -->

  <link name="camera_link">

    <visual>

      <geometry>
        <box size="0.035 0.050 0.030"/>
      </geometry>

      <material name="sensor_dark"/>

    </visual>


    <visual>

      <origin
          xyz="0.0225 0 0"
          rpy="0 ${pi / 2.0} 0"/>

      <geometry>

        <cylinder
            radius="0.012"
            length="0.010"/>

      </geometry>

      <material name="camera_lens_colour"/>

    </visual>


    <collision>

      <geometry>
        <box size="0.035 0.050 0.030"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="0.05"/>

      <inertia
          ixx="0.00002"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00002"
          iyz="0.0"
          izz="0.00002"/>

    </inertial>

  </link>


  <joint
      name="camera_joint"
      type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin
        xyz="0.14 0.00 0.08"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LIDAR LINK                                               -->
  <!-- ========================================================= -->

  <link name="laser_link">

    <visual>

      <geometry>

        <cylinder
            radius="0.025"
            length="0.040"/>

      </geometry>

      <material name="sensor_dark"/>

    </visual>


    <visual>

      <origin
          xyz="0 0 -0.035"
          rpy="0 0 0"/>

      <geometry>

        <cylinder
            radius="0.008"
            length="0.030"/>

      </geometry>

      <material name="steering_grey"/>

    </visual>


    <collision>

      <geometry>

        <cylinder
            radius="0.025"
            length="0.040"/>

      </geometry>

    </collision>


    <inertial>

      <mass value="0.08"/>

      <inertia
          ixx="0.00003"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00003"
          iyz="0.0"
          izz="0.00003"/>

    </inertial>

  </link>


  <joint
      name="laser_joint"
      type="fixed">

    <parent link="base_link"/>
    <child link="laser_link"/>

    <origin
        xyz="0.00 0.00 0.18"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- GAZEBO VISUAL MATERIALS                                  -->
  <!-- ========================================================= -->

  <!-- Blue chassis -->

  <gazebo reference="base_link">

    <material>Gazebo/Blue</material>

  </gazebo>


  <!-- Grey steering knuckles -->

  <gazebo reference="front_left_steering_link">

    <material>Gazebo/Grey</material>

  </gazebo>


  <gazebo reference="front_right_steering_link">

    <material>Gazebo/Grey</material>

  </gazebo>


  <!-- ========================================================= -->
  <!-- WHEEL MATERIALS AND CONTACT                              -->
  <!-- ========================================================= -->

  <gazebo reference="front_left_wheel_link">

    <material>Gazebo/FlatBlack</material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="front_right_wheel_link">

    <material>Gazebo/FlatBlack</material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="rear_left_wheel_link">

    <material>Gazebo/FlatBlack</material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <gazebo reference="rear_right_wheel_link">

    <material>Gazebo/FlatBlack</material>

    <mu1>1.0</mu1>
    <mu2>1.0</mu2>

    <kp>1000000.0</kp>
    <kd>1.0</kd>

  </gazebo>


  <!-- ========================================================= -->
  <!-- GAZEBO RGB CAMERA                                        -->
  <!-- ========================================================= -->

  <gazebo reference="camera_link">

    <material>Gazebo/DarkGrey</material>


    <sensor
        name="front_camera"
        type="camera">

      <always_on>true</always_on>

      <update_rate>10.0</update_rate>

      <visualize>true</visualize>


      <camera name="camera">

        <horizontal_fov>1.3962634</horizontal_fov>


        <image>

          <width>640</width>

          <height>480</height>

          <format>R8G8B8</format>

        </image>


        <clip>

          <near>0.02</near>

          <far>10.0</far>

        </clip>

      </camera>


      <plugin
          name="camera_controller"
          filename="libgazebo_ros_camera.so">

        <ros>

          <namespace>/camera/color</namespace>

        </ros>

        <camera_name>camera</camera_name>

        <frame_name>camera_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>


  <!-- ========================================================= -->
  <!-- GAZEBO 2D LIDAR                                          -->
  <!-- ========================================================= -->

  <gazebo reference="laser_link">

    <material>Gazebo/DarkGrey</material>


    <sensor
        name="lidar"
        type="ray">

      <always_on>true</always_on>

      <update_rate>10.0</update_rate>


      <!-- Keep LiDAR rays visible -->

      <visualize>true</visualize>


      <pose>0 0 0 0 0 0</pose>


      <ray>

        <scan>

          <horizontal>

            <samples>360</samples>

            <resolution>1.0</resolution>

            <min_angle>-3.14159265359</min_angle>

            <max_angle>3.14159265359</max_angle>

          </horizontal>

        </scan>


        <range>

          <min>0.05</min>

          <max>8.0</max>

          <resolution>0.01</resolution>

        </range>


        <noise>

          <type>gaussian</type>

          <mean>0.0</mean>

          <stddev>0.005</stddev>

        </noise>

      </ray>


      <plugin
          name="laser_controller"
          filename="libgazebo_ros_ray_sensor.so">

        <ros>

          <namespace>/</namespace>

          <remapping>~/out:=scan</remapping>

        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>

        <frame_name>laser_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>


  <!-- ========================================================= -->
  <!-- ROS 2 CONTROL                                            -->
  <!-- ========================================================= -->

  <ros2_control
      name="GazeboSystem"
      type="system">

    <hardware>

      <plugin>gazebo_ros2_control/GazeboSystem</plugin>

    </hardware>


    <!-- Front-left steering -->

    <joint name="front_left_steering_joint">

      <command_interface name="position">

        <param name="min">${-steering_limit}</param>

        <param name="max">${steering_limit}</param>

      </command_interface>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- Front-right steering -->

    <joint name="front_right_steering_joint">

      <command_interface name="position">

        <param name="min">${-steering_limit}</param>

        <param name="max">${steering_limit}</param>

      </command_interface>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- Rear-left drive -->

    <joint name="rear_left_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- Rear-right drive -->

    <joint name="rear_right_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- Front-left free rolling -->

    <joint name="front_left_wheel_joint">

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>


    <!-- Front-right free rolling -->

    <joint name="front_right_wheel_joint">

      <state_interface name="position"/>

      <state_interface name="velocity"/>

    </joint>

  </ros2_control>


  <!-- ========================================================= -->
  <!-- GAZEBO ROS2 CONTROL                                      -->
  <!-- ========================================================= -->

  <gazebo>

    <plugin
        name="gazebo_ros2_control"
        filename="libgazebo_ros2_control.so">

      <parameters>$(arg controllers_file)</parameters>

    </plugin>

  </gazebo>


  <!-- ========================================================= -->
  <!-- GAZEBO GROUND-TRUTH ODOMETRY                             -->
  <!-- ========================================================= -->

  <!--
       Task 2 trajectory-analysis pose source.

       IMPORTANT:
       Gazebo Classic collapses the fixed base_link into
       base_footprint during URDF -> SDF conversion.

       Therefore P3D must track base_footprint rather than
       base_link.

       Output:
           /odom

       Message:
           nav_msgs/msg/Odometry

       This is ground-truth simulation data and is intended only
       for Task 2 model verification / trajectory analysis.
  -->

  <gazebo>

    <plugin
        name="ground_truth_odometry"
        filename="libgazebo_ros_p3d.so">

      <ros>

        <namespace>/</namespace>

        <!--
             The P3D plugin internally publishes "odom".
             Explicitly remap it to /odom.
        -->

        <remapping>odom:=odom</remapping>

      </ros>


      <!--
           Track the Gazebo physics root.

           Do NOT change this back to base_link unless
           base_link is explicitly preserved in the generated
           Gazebo SDF.
      -->

      <body_name>base_footprint</body_name>


      <!-- World-coordinate ground truth -->

      <frame_name>world</frame_name>


      <!-- 50 Hz trajectory sampling -->

      <update_rate>50.0</update_rate>


      <!-- No artificial pose offsets -->

      <xyz_offset>0 0 0</xyz_offset>

      <rpy_offset>0 0 0</rpy_offset>


      <!-- Ground truth: no measurement noise -->

      <gaussian_noise>0.0</gaussian_noise>

    </plugin>

  </gazebo>


</robot>
