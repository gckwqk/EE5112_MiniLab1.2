  "command_interface": {
    "n_colours_min": 1,
    "n_colours_max": 4,
    "colours_must_be_distinct": true,
    "allowed_colours": [
      "Red",
      "Orange",
      "Yellow",
      "Green",
      "Blue",
      "Purple",
      "Black"
    ],
    "languages": [
      "en"
    ],
    "english_only": true,
    "example_commands_en": [
      "find red",
      "find red and blue",
      "find red, blue and yellow",
      "find red, blue, yellow and green"
    ],
    "reject_if": [
      "empty",
      "more_than_4_colours",
      "repeated_colour",
      "colour_not_in_allowed_list"
    ],
    "cmd_example_line": "[CMD] colours=Red, Blue n=2",
    "search_order": "exactly the order named in the command",
    "later_colour_not_counted_until_previous_found": true,
    "after_command_accepted": "The vehicle must start moving by itself and keep going until every commanded colour is found (C1-C3, in order) or the mission fails."
  },
  "mission": {
    "reuse_task1_vehicle_for_task2_and_task3": true,
    "task2_navigation": "fully_autonomous_after_command",
    "teleop_forbidden_in_graded_runs": true,
    "rviz_manual_nav_goal_forbidden_in_graded_runs": true,
    "found_definition": {
      "C1_camera_colour_detection": true,
      "no_groundtruth_only": true,
      "C2_proximity_radius_m": 0.5,
      "C2_reference": "planar Euclidean distance from base_link origin to block centre",
      "C2_formula": "d = sqrt( (x_base - x_block)^2 + (y_base - y_block)^2 )",
      "C2_ignore_z": true,
      "C2_note": "Planar distance is the Euclidean distance in the horizontal plane. z is ignored.",
      "C3_log_event": true,
      "C3_terminal_or_rosout_print": true,
      "C3_example_line": "[FOUND] colour=Blue t=12.3s x=3.40 y=2.10",
      "C3_log_file_optional": true,
      "C3_save_image_optional": true,
      "contact_not_required": true,
      "closer_than_0_50_m_allowed": true,
      "video_terminal_visible_throughout_task2_task3": true,
      "video_without_terminal_incomplete": true
    },
    "start_moving_immediately_after_command": true,
    "run_until": [
      "all_commanded_colours_found",
      "mission_failed"
    ],
    "suggested_timeout_s": 180,
    "mission_log_examples": [
      "[MISSION] status=SUCCESS",
      "[MISSION] status=FAIL reason=timeout"
    ]
  },
  "task3_speech": {
    "required": true,
    "implementation_required": true,
    "video_required": true,
    "must_pipe_into_task2": true,
    "stt_only_without_search_incomplete": true,
